rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User Profile Document
    match /users/{userId} {
      allow read, create, update: if isOwner(userId);
      allow delete: if false;

      // Invoices Subcollection
      match /invoices/{invoiceId} {
        allow read, write: if isOwner(userId);
      }

      // Company Info Subcollection
      match /company/{docId} {
        allow read, write: if isOwner(userId);
      }

      // Parties Subcollection
      match /parties/{partyId} {
        allow read, write: if isOwner(userId);
      }

      // Protected Subscription Subcollection
      // Clients can READ their verified entitlement, but CANNOT write/modify payment status.
      // Subscription entitlement is updated only by trusted Firebase Cloud Functions.
      match /subscription/{docId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
    }

    // Deny all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
